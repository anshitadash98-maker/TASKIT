# TASKIT Environment Configuration Example
# Copy this file to .env and replace with your actual values

PORT=5000
JWT_SECRET=your_jwt_secret_key_here

# Persistent Production Database (Required for Vercel deployment)
# Recommended: Neon PostgreSQL (e.g., postgresql://username:password@ep-xyz.region.neon.tech/taskit?sslmode=require)
DATABASE_URL=

# Google OAuth (Disabled by default)
ENABLE_GOOGLE_AUTH=false
GOOGLE_CLIENT_ID=

# Optional: Google Gemini API Key for TASKIT AI
# If not provided, TASKIT uses its built-in deterministic heuristic engine
GEMINI_API_KEY=
